<!DOCTYPE html>
<html>
  <head>
    <title>Plataforma de Gestão Documental</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <!-- Solução Nuclear: CDN e CSS Inline para bypass total do Rails -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>

  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
    <% if logged_in? %>
      <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-2 text-slate-900 font-bold tracking-tight text-lg">
              <span class="bg-blue-600 text-white text-xs px-2 py-1 rounded font-mono">CEBAS</span>
              Gestão Documental
            </a>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 font-medium">
              Acesso Restrito
            </span>
            <form action="/session" method="POST" class="m-0 p-0 inline">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="text-xs text-red-600 hover:text-red-700 font-medium cursor-pointer bg-transparent border-0">
                Sair
              </button>
            </form>
          </div>
        </div>
      </header>
    <% end %>

    <!-- O yield é a única coisa que o Rails precisa processar aqui agora -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>